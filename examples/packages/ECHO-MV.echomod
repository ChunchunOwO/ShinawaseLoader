ba(255, 255, 255, 0.16);\r\n  border-radius: 999px;\r\n  background: rgba(255, 255, 255, 0.1);\r\n  cursor: pointer;\r\n}\r\n.lyrics-mv-diagnostics-report textarea {\r\n  width: 100%;\r\n  height: 168px;\r\n  resize: vertical;\r\n  box-sizing: border-box;\r\n  padding: 9px;\r\n  color: rgba(238, 244, 252, 0.88);\r\n  border: 1px solid rgba(255, 255, 255, 0.12);\r\n  border-radius: 10px;\r\n  outline: none;\r\n  background: rgba(2, 6, 12, 0.48);\r\n  font-family: ui-monospace, SFMono-Regular, Consolas, \"Liberation Mono\", monospace;\r\n  font-size: 11px;\r\n  line-height: 1.42;\r\n}\r\n.lyrics-mv-card {\r\n  position: relative;\r\n  display: grid;\r\n  width: min(78vh, 100%);\r\n  max-width: 560px;\r\n  aspect-ratio: 16 / 10;\r\n  overflow: hidden;\r\n  grid-template-columns: minmax(150px, 0.88fr) minmax(0, 1fr);\r\n  align-items: center;\r\n  gap: clamp(18px, 3.2vw, 30px);\r\n  padding: clamp(20px, 3.4vw, 34px);\r\n  color: #31425a;\r\n  border: 1px solid var(--theme-legacy-surface-a64, rgba(255, 255, 255, 0.64));\r\n  border-radius: 26px;\r\n  background:\r\n    linear-gradient(\r\n      145deg,\r\n      var(--theme-legacy-surface-a90, rgba(255, 255, 255, 0.90)),\r\n      rgba(232, 237, 244, 0.82)\r\n    ),\r\n    #f2f2f4;\r\n  box-shadow:\r\n    0 34px 90px rgba(0, 0, 0, 0.18),\r\n    inset 0 1px 0 var(--theme-legacy-surface-a76, rgba(255, 255, 255, 0.76));\r\n}\r\n.lyrics-mv-card-backdrop {\r\n  position: absolute;\r\n  inset: 0;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n}\r\n.lyrics-mv-card-backdrop::before {\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    radial-gradient(circle at 24% 26%, rgba(255, 255, 255, 0.7), transparent 28%),\r\n    linear-gradient(135deg, rgba(70, 94, 132, 0.12), rgba(255, 255, 255, 0.44));\r\n  content: \"\";\r\n}\r\n.lyrics-mv-card-backdrop img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  filter: blur(30px) saturate(1.05);\r\n  opacity: 0.24;\r\n  transform: scale(1.16);\r\n}\r\n.lyrics-mv-artwork,\r\n.lyrics-mv-copy {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n.lyrics-mv-artwork {\r\n  display: grid;\r\n  width: min(100%, 190px);\r\n  aspect-ratio: 1;\r\n  justify-self: end;\r\n  overflow: hidden;\r\n  place-items: center;\r\n  color: var(--theme-muted-text);\r\n  border: 5px solid var(--theme-legacy-surface-a90, rgba(255, 255, 255, 0.90));\r\n  border-radius: 20px;\r\n  background: linear-gradient(145deg, var(--theme-on-accent), #e7e7eb);\r\n  box-shadow:\r\n    0 20px 46px rgba(31, 48, 70, 0.2),\r\n    inset 0 0 0 1px rgba(29, 29, 31, 0.05);\r\n}\r\n.lyrics-mv-card[data-cover=\"true\"] .lyrics-mv-artwork img {\r\n  filter: saturate(1.02);\r\n}\r\n.lyrics-mv-copy {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 8px;\r\n}\r\n.lyrics-mv-player {\r\n  position: relative;\r\n  display: grid;\r\n  width: min(78vh, 100%);\r\n  max-width: 680px;\r\n  aspect-ratio: 16 / 9;\r\n  overflow: hidden;\r\n  color: #eef3f7;\r\n  border: 1px solid var(--theme-legacy-surface-a64, rgba(255, 255, 255, 0.64));\r\n  border-radius: 26px;\r\n  background: #111821;\r\n  box-shadow:\r\n    0 34px 90px rgba(0, 0, 0, 0.18),\r\n    inset 0 1px 0 var(--theme-legacy-white-a12, rgba(255, 255, 255, 0.12));\r\n}\r\n.lyrics-mv-video {\r\n  width: 100%;\r\n  height: 100%;\r\n  border: 0;\r\n  background: #111821;\r\n  object-fit: contain;\r\n}\r\n.lyrics-mv-actions button,\r\n.lyrics-mv-candidate-badges small {\r\n  display: inline-flex;\r\n  min-height: 30px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  padding: 0 10px;\r\n  border-radius: 8px;\r\n  font-size: 11px;\r\n  font-weight: 820;\r\n  white-space: nowrap;\r\n}\r\n.lyrics-mv-actions {\r\n  display: flex;\r\n  width: min(78vh, 100%);\r\n  max-width: 680px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n.lyrics-mv-actions button {\r\n  color: var(--theme-muted-text);\r\n  border: 1px solid var(--theme-legacy-border, var(--theme-panel-border-strong, rgba(38, 40, 46, 0.18)));\r\n  background: var(--theme-panel-bg);\r\n  box-shadow:\r\n    0 1px 2px rgba(35, 54, 78, 0.04),\r\n    inset 0 1px 0 var(--theme-legacy-surface-a72, rgba(255, 255, 255, 0.72));\r\n  cursor: pointer;\r\n}\r\n.lyrics-mv-actions button:hover,\r\n.lyrics-mv-candidate:hover {\r\n  background: var(--theme-legacy-surface-a90, rgba(255, 255, 255, 0.90));\r\n}\r\n.lyrics-mv-actions button:disabled,\r\n.lyrics-mv-candidate:disabled {\r\n  cursor: default;\r\n  opacity: 0.52;\r\n}\r\n.lyrics-mv-candidates {\r\n  display: grid;\r\n  width: min(78vh, 100%);\r\n  max-width: 680px;\r\n  max-height: 220px;\r\n  gap: 8px;\r\n  overflow: auto;\r\n  padding: 2px;\r\n}\r\n.lyrics-mv-candidate {\r\n  display: grid;\r\n  width: 100%;\r\n  min-height: 54px;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 9px 11px;\r\n  color: #26384f;\r\n  border: 1px solid var(--theme-legacy-border-soft, var(--theme-panel-border, rgba(38, 40, 46, 0.1)));\r\n  border-radius: 8px;\r\n  background: var(--theme-panel-bg);\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n.lyrics-mv-candidate > span:first-child {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 3px;\r\n}\r\n.lyrics-mv-candidate strong,\r\n.lyrics-mv-candidate em {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.lyrics-mv-candidate strong {\r\n  color: var(--theme-legacy-page-text, var(--theme-page-text, #26384f));\r\n  font-size: 13px;\r\n  font-weight: 840;\r\n}\r\n.lyrics-mv-candidate em {\r\n  color: rgba(66, 84, 107, 0.68);\r\n  font-size: 11px;\r\n  font-style: normal;\r\n  font-weight: 720;\r\n}\r\n.lyrics-mv-candidate-badges {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n.lyrics-mv-candidate-badges small {\r\n  min-height: 22px;\r\n  padding: 0 7px;\r\n  color: #456076;\r\n  background: rgba(226, 235, 244, 0.84);\r\n  line-height: 22px;\r\n}\r\n.lyrics-mv-error {\r\n  width: min(78vh, 100%);\r\n  max-width: 680px;\r\n  margin: 0;\r\n  color: #b3261e;\r\n  font-size: 12px;\r\n  font-weight: 760;\r\n  text-align: center;\r\n}\r\n.lyrics-mv-placeholder {\r\n  display: grid;\r\n  width: 100%;\r\n  height: 100%;\r\n  place-items: center;\r\n  background:\r\n    radial-gradient(\r\n      circle at 32% 24%,\r\n      var(--theme-legacy-surface-a86, rgba(255, 255, 255, 0.86)),\r\n      transparent 30%\r\n    ),\r\n    linear-gradient(145deg, #ffffff, #e7e7eb);\r\n}\r\n.lyrics-mv-copy span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: fit-content;\r\n  min-height: 26px;\r\n  padding: 0 9px;\r\n  color: var(--theme-muted-text);\r\n  border: 1px solid var(--theme-legacy-border-soft, var(--theme-panel-border, rgba(38, 40, 46, 0.1)));\r\n  border-radius: 8px;\r\n  background: var(--theme-legacy-surface-a58, rgba(255, 255, 255, 0.58));\r\n  font-size: 11px;\r\n  font-weight: 850;\r\n  text-transform: uppercase;\r\n}\r\n.lyrics-mv-copy strong,\r\n.lyrics-mv-copy em {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.lyrics-mv-copy strong {\r\n  color: #203149;\r\n  font-size: clamp(18px, 2vw, 24px);\r\n  font-weight: 850;\r\n  line-height: 1.08;\r\n}\r\n.lyrics-mv-copy em {\r\n  color: rgba(55, 74, 98, 0.68);\r\n  font-size: 14px;\r\n  font-style: normal;\r\n  font-weight: 740;\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-mv-unavailable-reason {\r\n  color: rgba(226, 234, 244, 0.86);\r\n  border-color: rgba(255, 255, 255, 0.12);\r\n  background: rgba(14, 22, 34, 0.46);\r\n  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.22);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-mv-unavailable-reason span {\r\n  color: rgba(201, 214, 232, 0.62);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-mv-unavailable-reason strong {\r\n  color: rgba(244, 248, 255, 0.94);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-mv-unavailable-close {\r\n  color: rgba(201, 214, 232, 0.58);\r\n}\r\n