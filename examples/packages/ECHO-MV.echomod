) {\r\n    if (panelActive() || shouldAutoSearch()) void loadSelected({ preserveCurrent: true });\r\n  }\r\n};\r\n\r\nconst startTimers = () => {\r\n  const tick = () => {\r\n    if (disposed) return;\r\n    void refreshPlayback();\r\n    if (panelActive() && state.isAudioPlaying && shouldFollowMusic(state.settings, state.selectedVideo, state.streamingTarget)) {\r\n      syncVideos();\r\n    }\r\n  };\r\n  timers.poll = window.setInterval(tick, 250);\r\n  void tick();\r\n};\r\n\r\nconst observeDom = () => {\r\n  const scan = () => {\r\n    const lyricsButton = document.querySelector('button.transport-lyrics-button');\r\n    if (lyricsButton) mountTransportButton(lyricsButton);\r\n    mountSettingsButton();\r\n    applyPageFlags();\r\n    if (!isLyricsPageVisible()) return;\r\n    if (ownedPanelEl()) ownedPanelEl().remove();\r\n    if (panelActive() && !refs.background) renderPanel();\r\n  };\r\n  scan();\r\n  let scanTimer = 0;\r\n  const observer = new MutationObserver(() => {\r\n    if (scanTimer) return;\r\n    scanTimer = window.setTimeout(() => { scanTimer = 0; if (!disposed) scan(); }, 80);\r\n  });\r\n  observer.observe(document.documentElement, { childList: true, subtree: true });\r\n  disposers.push(() => {\r\n    observer.disconnect();\r\n    window.clearTimeout(scanTimer);\r\n  });\r\n  if (external.extend?.observe) {\r\n    disposers.push(external.extend.observe('button.transport-lyrics-button', (node) => mountTransportButton(node)));\r\n  }\r\n};\r\n\r\nconst injectCss = async () => {\r\n  let cssText = EMBEDDED_CSS;\r\n  try {\r\n    const loaded = await external.loadAsset?.('mv.css');\r\n    if (typeof loaded === 'string' && loaded.trim()) cssText = loaded;\r\n  } catch {}\r\n  if (external.extend?.css) {\r\n    disposers.push(external.extend.css(CSS_ID, cssText));\r\n    return;\r\n  }\r\n  const style = el('style', '', { id: CSS_ID });\r\n  style.textContent = cssText;\r\n  document.head.append(style);\r\n  disposers.push(() => style.remove());\r\n};\r\n\r\nconst onVisibility = () => {\r\n  if (document.hidden) {\r\n    refs.foregroundVideo?.pause();\r\n    refs.backgroundVideo?.pause();\r\n  } else if (state.isAudioPlaying && panelActive()) {\r\n    if (refs.foregroundVideo) playVideo(refs.foregroundVideo);\r\n    if (refs.backgroundVideo) playVideo(refs.backgroundVideo);\r\n    syncVideos({ force: true, bypassCooldown: true });\r\n  }\r\n};\r\n\r\nconst addWin = (type, handler, options) => {\r\n  window.addEventListener(type, handler, options);\r\n  disposers.push(() => window.removeEventListener(type, handler, options));\r\n};\r\n\r\naddWin('keydown', onKeyDown, true);\r\naddWin(SETTINGS_CHANGED_EVENT, onSettingsChanged);\r\naddWin(MV_CHANGED_EVENT, onMvChanged);\r\naddWin(MV_CANDIDATES_EVENT, onCandidatesChanged);\r\naddWin(PLAYBACK_SEEKED_EVENT, onSeeked);\r\naddWin(NAV_LYRICS_EVENT, onNavigateLyrics);\r\naddWin(OPEN_MV_SETTINGS_EVENT, () => openDrawer(true));\r\naddWin(DIAGNOSTICS_EVENT, (event) => {\r\n  const enabled = event instanceof CustomEvent ? event.detail?.enabled : readDiagnostics();\r\n  state.diagnosticsEnabled = enabled === true;\r\n  scheduleRender();\r\n});\r\naddWin(IMMERSIVE_WHEEL_EVENT, (event) => {\r\n  const deltaY = Number(event instanceof CustomEvent ? event.detail?.deltaY : 0);\r\n  if (!deltaY || !refs.background) return;\r\n  const direction = deltaY < 0 ? 1 : -1;\r\n  void patchSettings({ immersiveBackgroundScalePercent: clampScale((state.settings.immersiveBackgroundScalePercent ?? 115) + direction * SCALE_WHEEL_STEP) });\r\n});\r\ndocument.addEventListener('visibilitychange', onVisibility);\r\ndisposers.push(() => document.removeEventListener('visibilitychange', onVisibility));\r\nconst flushSheetRender = () => {\r\n  if (!pendingDrawerRender) return;\r\n  scheduleRender();\r\n};\r\ndocument.addEventListener('pointerup', flushSheetRender, true);\r\ndocument.addEventListener('pointercancel', flushSheetRender, true);\r\ndisposers.push(() => {\r\n  document.removeEventListener('pointerup', flushSheetRender, true);\r\n  document.removeEventListener('pointercancel', flushSheetRender, true);\r\n});\r\n\r\ntry {\r\n  const off = echoApi().audio?.onStatus?.((status) => {\r\n    state.audioStatus = status;\r\n    if (!lyricsVisible() && !panelActive()) return;\r\n    void refreshPlayback();\r\n  });\r\n  if (typeof off === 'function') disposers.push(off);\r\n} catch {}\r\n\r\nvoid injectCss();\r\nrememberViewMode(state.viewMode);\r\nvoid applyLocaleFromApp().then(() => scheduleRender());\r\nvoid loadSettings().then(() => {\r\n  rememberViewMode(state.viewMode);\r\n  applyPageFlags();\r\n  if (lyricsVisible() && (panelActive() || shouldAutoSearch())) void loadSelected();\r\n  scheduleRender();\r\n});\r\nobserveDom();\r\nstartTimers();\r\nlog('ECHO-MV renderer ready');\r\n\r\nconst dispose = () => {\r\n  if (disposed) return;\r\n  disposed = true;\r\n  window.__echoMvModActive = false;\r\n  Object.values(timers).forEach((id) => {\r\n    window.clearTimeout(id);\r\n    window.clearInterval(id);\r\n    window.cancelAnimationFrame(id);\r\n  });\r\n  resizeObserver?.disconnect();\r\n  refs.transportBtn?.remove();\r\n  refs.settingsBtn?.remove();\r\n  refs.drawerRoot?.remove();\r\n  restorePanel();\r\n  uninstallMvApi();\r\n  while (disposers.length) {\r\n    try { disposers.pop()?.(); } catch {}\r\n  }\r\n};\r\n\r\nreturn dispose;\r\n\n"
    },
    {
      "path": "mv.css",
      "content": "/* === lyrics.css === */\r\n.lyrics-left-panel,\r\n.lyrics-mv-panel,\r\n.lyrics-no-track,\r\n.lyrics-empty,\r\n.lyrics-error,\r\n.lyrics-copy-notice,\r\n.lyrics-custom-lrc-drop {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-host-style=\"true\"]) {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-host-style=\"true\"]) .lyrics-scroll {\r\n  width: min(100%, 1320px);\r\n  justify-self: center;\r\n  padding-inline: clamp(22px, 5vw, 120px);\r\n  transform: none;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-host-style=\"true\"]) .lyrics-back-button {\r\n  justify-self: start;\r\n}\r\n.lyrics-mv-background {\r\n  --mv-immersive-blur: 0px;\r\n  --mv-immersive-brightness: 100%;\r\n  --mv-immersive-overlay-opacity: 0;\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  overflow: hidden;\r\n  background: #101820;\r\n  cursor: grab;\r\n  touch-action: none;\r\n}\r\n.lyrics-mv-background[data-dragging=\"true\"] {\r\n  cursor: grabbing;\r\n}\r\n.lyrics-mv-background::after {\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    linear-gradient(90deg, rgba(8, 11, 16, 0.72), rgba(8, 11, 16, 0.42) 48%, rgba(8, 11, 16, 0.62)),\r\n    linear-gradient(180deg, rgba(8, 11, 16, 0.22), rgba(8, 11, 16, 0.68));\r\n  content: \"\";\r\n  opacity: var(--mv-immersive-overlay-opacity);\r\n  pointer-events: none;\r\n}\r\n.lyrics-mv-background-video {\r\n  width: 100%;\r\n  height: 100%;\r\n  border: 0;\r\n  object-fit: cover;\r\n  object-position: var(--mv-immersive-position-x, 50%) var(--mv-immersive-position-y, 50%);\r\n  transform: translateZ(0) scale(var(--mv-immersive-scale, 1.15));\r\n  transform-origin: var(--mv-immersive-position-x, 50%) var(--mv-immersive-position-y, 50%);\r\n  transition: transform 180ms cubic-bezier(0.2, 0, 0.2, 1);\r\n  filter: blur(var(--mv-immersive-blur)) saturate(1.05) brightness(var(--mv-immersive-brightness));\r\n  backface-visibility: hidden;\r\n  will-change: transform;\r\n}\r\n.lyrics-mv-background[data-auto-scale=\"true\"] .lyrics-mv-background-video:not(.lyrics-mv-background-video--youtube) {\r\n  object-fit: contain;\r\n}\r\n.lyrics-mv-background-video--youtube {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: max(100vw, calc(100vh * 16 / 9));\r\n  height: max(100vh, calc(100vw * 9 / 16));\r\n  object-fit: initial;\r\n  pointer-events: none;\r\n  transform: translate(-50%, -50%) translateZ(0) scale(var(--mv-immersive-scale, 1.15));\r\n  transform-origin: center;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop {\r\n  background: transparent !important;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop::before {\r\n  opacity: 0 !important;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop::after {\r\n  opacity: 0 !important;\r\n}\r\n/* Ambience layers postdate the original MV feature and paint a nearly opaque\r\n   tint above z-index 0; hide them while the immersive MV background is active. */\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop-source,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop-cover,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop-previous-cover,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop-atmosphere,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-backdrop-theme-filter,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-music-reactive-layer {\r\n  display: none !important;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) {\r\n  --lyrics-mv-heading-color: color-mix(\r\n    in srgb,\r\n    color-mix(in srgb, var(--theme-heading-text) 46%, #ffffff 54%) 76%,\r\n    var(--theme-accent-solid-bg) 24%\r\n  );\r\n  --lyrics-mv-muted-color: color-mix(\r\n    in srgb,\r\n    color-mix(in srgb, var(--theme-muted-text) 38%, #ffffff 62%) 82%,\r\n    var(--theme-accent-solid-bg) 18%\r\n  );\r\n  --lyrics-mv-control-color: color-mix(in srgb, var(--lyrics-mv-heading-color) 88%, #ffffff 12%);\r\n  --lyrics-mv-control-bg: color-mix(in srgb, var(--theme-panel-bg-strong) 44%, transparent);\r\n  --lyrics-mv-control-border: color-mix(in srgb, var(--theme-accent-solid-bg) 36%, #ffffff 64%);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-copy h1,\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-copy p,\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-album,\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-artist {\r\n  color: var(--lyrics-mv-muted-color);\r\n  text-shadow: none;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-back-button,\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-match-status,\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-empty {\r\n  color: var(--lyrics-mv-muted-color);\r\n  text-shadow:\r\n    0 2px 4px rgb(0 0 0 / 0.62),\r\n    0 12px 28px var(--theme-overlay-bg);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-copy h1 {\r\n  color: var(--lyrics-mv-heading-color);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-album:hover {\r\n  color: var(--lyrics-mv-heading-color);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-back-button {\r\n  color: var(--lyrics-mv-control-color);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-back-button:hover {\r\n  color: var(--lyrics-mv-heading-color);\r\n  background: transparent;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line {\r\n  color: var(--lyrics-readable-color);\r\n  text-shadow: 0 2px 16px var(--theme-overlay-bg);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-past=\"true\"] {\r\n  opacity: 0.2;\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-active=\"true\"] {\r\n  color: var(--lyrics-readable-color);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) {\r\n  --lyrics-readable-color: color-mix(in srgb, var(--theme-heading-text) 86%, var(--lyrics-color) 14%);\r\n  --lyrics-word-accent-color: color-mix(in srgb, var(--color-accent-strong) 72%, var(--theme-heading-text) 28%);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-mv-background::after {\r\n  opacity: max(var(--mv-immersive-overlay-opacity), 0.42);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-focus-distance=\"1\"],\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-focus-distance=\"2\"],\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-focus-distance=\"3\"],\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-line[data-focus-distance=\"4\"] {\r\n  opacity: var(--lyrics-context-opacity);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background):not([data-echo-mv-stage=\"true\"]) .lyrics-track-cover {\r\n  border-color: rgba(255, 255, 255, 0.32);\r\n  background: var(--theme-legacy-white-a18, rgba(255, 255, 255, 0.18));\r\n  box-shadow: 0 20px 52px var(--theme-overlay-bg);\r\n}\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-mv-panel[data-immersive-active=\"true\"] {\r\n  display: none;\r\n}\r\n.lyrics-page:has(.lyrics-mv-panel[data-mv-enabled=\"false\"]) .lyrics-mv-panel {\r\n  display: none;\r\n}\r\n.lyrics-page:has(.lyrics-mv-panel[data-mv-enabled=\"true\"][data-immersiv