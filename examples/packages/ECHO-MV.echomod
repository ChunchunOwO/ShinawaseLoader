ate,\r\nhtml[data-theme=\"dark\"] .lyrics-match-panel .lyrics-candidate {\r\n  --lyrics-candidate-text: #26384f;\r\n  --lyrics-candidate-title-color: #23324a;\r\n  --lyrics-candidate-meta-color: rgba(66, 84, 107, 0.76);\r\n  --lyrics-candidate-border: rgba(54, 73, 95, 0.14);\r\n  --lyrics-candidate-bg: rgba(255, 255, 255, 0.86);\r\n  --lyrics-candidate-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);\r\n}\r\nhtml[data-theme=\"dark\"] .lyrics-match-panel .lyrics-candidate-next-step,\r\n.lyrics-page:has(.lyrics-mv-background) .lyrics-match-panel .lyrics-candidate-next-step {\r\n  color: #456076;\r\n  background: rgba(226, 235, 244, 0.84);\r\n}\r\n.lyrics-mv-panel {\r\n  position: relative;\r\n  display: grid;\r\n  min-height: 0;\r\n  align-content: center;\r\n  justify-items: center;\r\n  gap: 12px;\r\n  transform: translateY(clamp(20px, 4.2vh, 58px));\r\n  transition:\r\n    opacity var(--echo-motion-panel-ms) var(--echo-motion-ease-quick),\r\n    transform var(--echo-motion-panel-ms) var(--echo-motion-ease-quick);\r\n}\r\n.lyrics-mv-ambient {\r\n  position: absolute;\r\n  width: min(68%, 560px);\r\n  aspect-ratio: 1;\r\n  border-radius: 36px;\r\n  background-position: center;\r\n  background-size: cover;\r\n  filter: blur(42px) saturate(1.15);\r\n  opacity: 0.24;\r\n}\r\n.lyrics-mv-unavailable-reason {\r\n  position: fixed;\r\n  top: clamp(88px, 8vh, 112px);\r\n  left: clamp(14px, 1.8vw, 24px);\r\n  z-index: 7;\r\n  display: grid;\r\n  max-width: min(280px, calc(100vw - 28px));\r\n  grid-template-columns: minmax(0, 1fr) 18px;\r\n  gap: 2px 7px;\r\n  padding: 7px 7px 7px 9px;\r\n  color: rgba(43, 56, 74, 0.86);\r\n  border: 1px solid rgba(255, 255, 255, 0.66);\r\n  border-radius: 10px;\r\n  background: rgba(255, 255, 255, 0.48);\r\n  box-shadow: 0 10px 28px rgba(51, 68, 94, 0.08);\r\n  backdrop-filter: blur(14px);\r\n  opacity: 0.78;\r\n  transition: opacity 160ms ease, transform 160ms ease;\r\n}\r\n.lyrics-mv-unavailable-reason:hover,\r\n.lyrics-mv-unavailable-reason