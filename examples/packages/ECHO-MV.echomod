template-columns: 1fr;\r\n    aspect-ratio: auto;\r\n    min-height: 280px;\r\n    justify-items: center;\r\n    text-align: center;\r\n  }\r\n.lyrics-mv-artwork {\r\n    width: 148px;\r\n    justify-self: center;\r\n  }\r\n.lyrics-mv-copy {\r\n    justify-items: center;\r\n  }\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n.lyrics-backdrop::after,\r\n  .lyrics-backdrop-cover,\r\n  .lyrics-backdrop-previous-cover,\r\n  .lyrics-mv-background-video,\r\n  .lyrics-page[data-track-transition=\"true\"][data-lyrics-page-style=\"roseVinyl\"]::after,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-backdrop::after,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-backdrop-cover,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-track-header,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-track-cover,\r\n  .lyrics-style-cover-card-image,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-track-copy,\r\n  .lyrics-page[data-track-transition=\"true\"] .lyrics-scroll {\r\n    animation: none !important;\r\n    transition: none !important;\r\n    will-change: auto;\r\n  }\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"],\r\n.app-shell--lyrics-player-drawer .lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"] {\r\n  display: grid;\r\n  grid-column: 2;\r\n  grid-row: 1;\r\n  place-items: center;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-window-maximized=\"true\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"],\r\n.app-shell--lyrics-player-drawer .lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-window-maximized=\"true\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"] {\r\n  transform: translateY(clamp(-56px, -4.5vh, -36px));\r\n}\r\n@media (min-width: 901px) and (max-height: 1000px) {\r\n.lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-window-maximized=\"false\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"],\r\n  .app-shell--lyrics-player-drawer .lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-window-maximized=\"false\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"] {\r\n    place-items: start center;\r\n    padding-top: clamp(82px, 11vh, 104px);\r\n  }\r\n}\r\n@media (max-width: 900px) {\r\n.lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"],\r\n  .app-shell--lyrics-player-drawer .lyrics-page[data-lyrics-page-style=\"roseVinyl\"][data-view-mode=\"lyrics\"][data-background=\"cover\"] .lyrics-mv-panel[data-mv-enabled=\"false\"] {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* === app.css === */\r\n.settings-page .settings-cache-panel--mv-overview,\r\n.settings-page .settings-cache-panel--mv-network,\r\n.settings-page .settings-cache-panel--mv-immersive {\r\n  max-width: min(100%, 1120px);\r\n  gap: 10px;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  box-shadow: none;\r\n}\r\n.settings-page .settings-cache-panel--mv-network > .settings-chip-row,\r\n.settings-page .settings-cache-panel--mv-immersive > .settings-chip-row {\r\n  grid-column: 1 / -1;\r\n  max-width: none;\r\n}\r\n.settings-page .settings-cache-panel--mv-network .settings-inline-toggle,\r\n.settings-page .settings-cache-panel--mv-immersive .settings-inline-toggle {\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 36px;\r\n  justify-content: space-between;\r\n  padding: 0 9px 0 11px;\r\n  border-color: color-mix(in srgb, var(--theme-list-row-border) 70%, transparent);\r\n  border-radius: 4px;\r\n  background: color-mix(in srgb, var(--theme-list-row-bg) 68%, transparent);\r\n  box-shadow: none;\r\n}\r\n.settings-page .settings-cache-panel--mv-network .settings-inline-toggle span,\r\n.settings-page .settings-cache-panel--mv-immersive .settings-inline-toggle span {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive {\r\n  grid-template-columns: repeat(2, minmax(280px, 1fr));\r\n  align-items: center;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive > .settings-chip-row {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 1fr) auto;\r\n  gap: 8px;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive .settings-wallpaper-control {\r\n  grid-template-columns: minmax(76px, 116px) minmax(0, 1fr);\r\n  align-items: center;\r\n  gap: 8px 12px;\r\n  min-height: 40px;\r\n  padding: 7px 9px;\r\n  border-radius: 4px;\r\n  background: color-mix(in srgb, var(--theme-list-row-bg) 60%, transparent);\r\n  box-shadow: none;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive .settings-wallpaper-control > span {\r\n  color: var(--theme-page-text);\r\n  font-size: 12px;\r\n  font-weight: 820;\r\n  white-space: nowrap;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive .settings-range-field {\r\n  grid-template-columns: minmax(150px, 1fr) 48px;\r\n  gap: 8px;\r\n}\r\n.settings-page .settings-cache-panel--mv-immersive .settings-range-field span {\r\n  min-height: 26px;\r\n  font-size: 11px;\r\n}\r\n.settings-page .settings-mv-workspace > .setting-row:has(.settings-cache-panel--mv-immersive) {\r\n  min-width: 0;\r\n  grid-column: 1 / -1;\r\n  grid-template-columns: minmax(190px, 0.24fr) minmax(0, 0.76fr);\r\n  align-items: center;\r\n  gap: 20px;\r\n  padding: 14px 18px;\r\n  border: 1px solid var(--theme-panel-border);\r\n  border-radius: 8px;\r\n  background: var(--theme-panel-bg);\r\n  box-shadow: none;\r\n}\r\n.settings-page .settings-mv-workspace > .setting-row:has(.settings-cache-panel--mv-immersive) .setting-info h3 {\r\n  font-size: 14px;\r\n}\r\n.settings-page .settings-mv-workspace > .setting-row:has(.settings-cache-panel--mv-immersive) .setting-info p {\r\n  font-size: 11px;\r\n}\r\n.settings-page .settings-mv-workspace .settings-cache-panel--mv-immersive {\r\n  width: 100%;\r\n  max-width: none;\r\n  grid-template-columns: repeat(2, minmax(260px, 1fr));\r\n  gap: 8px;\r\n}\r\n.settings-page .settings-mv-workspace .settings-cache-panel--mv-immersive .settings-wallpaper-control {\r\n  min-width: 0;\r\n  min-height: 36px;\r\n  grid-template-columns: minmax(86px, 112px) minmax(0, 1fr);\r\n  padding: 4px 8px;\r\n}\r\n@media (max-width: 1500px) {\r\n.settings-page .settings-mv-workspace > .setting-row:has(.settings-cache-panel--mv-immersive) {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n.settings-page .settings-mv-workspace .settings-cache-panel--mv-immersive {\r\n    grid-template-columns: repeat(2, minmax(220px, 1fr));\r\n  }\r\n}\r\n@media (max-width: 760px) {\r\n.settings-page .settings-mv-side-column,\r\n  .settings-page .settings-mv-workspace .settings-cache-panel--mv-immersive,\r\n  .settings-page .settings-mv-primary-column .settings-mv-overview-card--quality,\r\n  .settings-page .settings-mv-primary-column .settings-cache-panel--mv-network > .settings-wallpaper-control {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n.lyrics-engine-meter .audio-engine-meter__top,\r\n.mv-engine-meter .audio-engine-meter__top {\r\n  grid-template-columns: 34px minmax(0, 1fr) 18px;\r\n}\r\n.mv-engine-meter .audio-engine-meter__grid {\r\n  grid-template-columns: minmax(0, 1.4fr) minmax(88px, 0.75fr);\r\n}\r\n.mv-settings-list {\r\n  display: grid;\r\n  gap: 9px;\r\n}\r\n.mv-settings-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n.mv-section-menu-open {\r\n  position: relative;\r\n  z-index: 5;\r\n}\r\n.mv-settings-drawer .mv-network-section,\r\n.echo-mv-sheet .mv-network-section {\r\n  order: 2;\r\n}\r\n.mv-network-section > :not(.audio-drawer-section-title):not(.echo-mv-section-title):not(.mv-quality-controls):not(.mv-source-list) {\r\n  order: 2;\r\n}\r\n.mv-network-section > .audio-drawer-section-title,\r\n.mv-network-section > .echo-mv-section-title {\r\n  order: 0;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  width: 100%;\r\n}\r\n.mv-network-section > .audio-drawer-section-title > span,\r\n.mv-network-section > .echo-mv-section-title > span {\r\n  display: inline-flex;\r\n  min-width: 0;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n.mv-section-collapse {\r\n  display: grid;\r\n  width: 30px;\r\n  height: 30px;\r\n  flex: 0 0 auto;\r\n  place-items: center;\r\n  color: rgba(232, 240, 255, 0.82);\r\n  border: 1px solid var(--theme-glass-bg-soft, rgba(255, 255, 255, 0.13));\r\n  border-radius: 8px;\r\n  background: var(--theme-glass-bg-muted, rgba(255, 255, 255, 0.09));\r\n  cursor: pointer;\r\n}\r\n.mv-section-collapse:hover {\r\n  color: var(--theme-overlay-text);\r\n  background: var(--theme-glass-bg-raised, rgba(255, 255, 255, 0.14));\r\n}\r\n.mv-section-collapse svg {\r\n  transition: transform 160ms ease;\r\n}\r\n.mv-network-section--open .mv-section-collapse svg {\r\n  transform: rotate(180deg);\r\n}\r\n.mv-network-section > .mv-quality-controls,\r\n.mv-network-section > .mv-source-list {\r\n  order: 1;\r\n}\r\n.mv-settings-drawer .audio-drawer-scroll {\r\n  padding-bottom: 96px;\r\n  scrollbar-color: rgba(228, 235, 255, 0.34) var(--theme-glass-bg-subtle, rgba(255, 255, 255, 0.05));\r\n  scrollbar-width: thin;\r\n}\r\n.mv-settings-drawer .audio-drawer-scroll::-webkit-scrollbar {\r\n  display: block;\r\n  width: 10px;\r\n}\r\n.mv-settings-drawer .audio-drawer-scroll::-webkit-scrollbar-track {\r\n  margin: 22px 0;\r\n  border-radius: 999px;\r\n  background: rgba(255, 255, 255, 0.05);\r\n}\r\n.mv-settings-drawer .audio-drawer-scroll::-webkit-scrollbar-thumb {\r\n  border: 3px solid rgba(0, 0, 0, 0);\r\n  border-radius: 999px;\r\n  ba