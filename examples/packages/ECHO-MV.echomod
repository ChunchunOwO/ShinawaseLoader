\r\n  color: var(--theme-accent-text-strong, currentColor);\r\n}\r\n\r\nsection.lyrics-mv-panel,\r\n.lyrics-mv-settings-entry {\r\n  display: none !important;\r\n}\r\n\r\n.echo-mv-root.audio-drawer-root {\r\n  z-index: 130;\r\n}\r\nbutton.echo-mv-corner,\r\nbutton[data-echo-lmwb-corner] {\r\n  display: none !important;\r\n}\r\n.echo-mv-sheet {\r\n  --echo-mv-sheet-text: var(--theme-overlay-text, rgba(236, 244, 255, .95));\r\n  --echo-mv-sheet-muted: var(--audio-drawer-muted-text, rgba(190, 204, 224, .72));\r\n  --echo-mv-sheet-border: rgba(255, 255, 255, .16);\r\n  --echo-mv-sheet-field-bg: var(--theme-glass-bg-subtle, rgba(255, 255, 255, .07));\r\n  --echo-mv-sheet-field-border: var(--theme-glass-bg-soft, rgba(165, 179, 228, .16));\r\n  --echo-mv-sheet-chip-bg: rgba(229, 237, 255, .12);\r\n  --echo-mv-sheet-chip-text: rgba(236, 244, 255, .86);\r\n  --echo-mv-sheet-soft-bg: rgba(255, 255, 255, .05);\r\n}\r\n.echo-mv-sheet.audio-drawer {\r\n  width: min(440px, calc(100vw - 18px));\r\n}\r\n.echo-mv-sheet .audio-drawer-scroll {\r\n  gap: 16px;\r\n  padding: 26px 20px 24px;\r\n}\r\n.echo-mv-sheet .mv-master-toggle {\r\n  width: 100%;\r\n  justify-content: flex-start;\r\n}\r\n.echo-mv-status {\r\n  margin: 0;\r\n  color: color-mix(in srgb, var(--echo-mv-sheet-text) 64%, transparent);\r\n  font-size: 12px;\r\n  font-weight: 760;\r\n}\r\n.echo-mv-current {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) auto;\r\n  gap: 8px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--echo-mv-sheet-field-border);\r\n  border-radius: 14px;\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-current span {\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n.echo-mv-current small {\r\n  color: color-mix(in srgb, var(--echo-mv-sheet-text) 58%, transparent);\r\n  font-size: 10px;\r\n  font-weight: 720;\r\n}\r\n.echo-mv-current strong {\r\n  overflow: hidden;\r\n  color: var(--echo-mv-sheet-text);\r\n  font-size: 12px;\r\n  font-weight: 840;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.echo-mv-quality {\r\n  display: flex;\r\n  min-width: 0;\r\n  gap: 6px;\r\n  overflow-x: auto;\r\n  padding-bottom: 1px;\r\n  scrollbar-width: thin;\r\n}\r\n.echo-mv-quality-item {\r\n  display: flex;\r\n  min-width: max-content;\r\n  flex: 0 0 auto;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 6px 8px;\r\n  color: var(--echo-mv-sheet-text);\r\n  border: 1px solid var(--echo-mv-sheet-field-border);\r\n  border-radius: 10px;\r\n  background: var(--echo-mv-sheet-field-bg);\r\n  cursor: pointer;\r\n}\r\n.echo-mv-quality-item[aria-pressed=\"true\"],\r\n.echo-mv-quality-item[data-active=\"true\"] {\r\n  color: #10251f;\r\n  border-color: rgba(143, 207, 189, .82);\r\n  background: #8fcfbd;\r\n}\r\n.echo-mv-quality-item strong {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  font-size: 12px;\r\n  font-weight: 840;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.echo-mv-quality-item small {\r\n  display: inline-flex;\r\n  min-height: 18px;\r\n  align-items: center;\r\n  padding: 0 6px;\r\n  color: #374c63b8;\r\n  border-radius: 999px;\r\n  background: #e2ebf4c2;\r\n  font-size: 10px;\r\n  font-weight: 780;\r\n  line-height: 1;\r\n  white-space: nowrap;\r\n}\r\n.echo-mv-sheet-body {\r\n  display: flex;\r\n  min-height: 0;\r\n  flex: 1 1 auto;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  overflow: auto;\r\n  padding: 2px 6px 8px 0;\r\n  scrollbar-width: thin;\r\n}\r\n.echo-mv-section,\r\n.echo-mv-section-title,\r\n.echo-mv-section-title h3 {\r\n  min-width: 0;\r\n}\r\n.echo-mv-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  flex: 0 0 auto;\r\n}\r\n.echo-mv-section-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: var(--echo-mv-sheet-text);\r\n}\r\n.echo-mv-section-title h3 {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 840;\r\n}\r\n.echo-mv-candidate-list {\r\n  display: flex;\r\n  flex: 0 0 auto;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  max-height: min(360px, 40vh);\r\n  overflow: auto;\r\n  align-content: start;\r\n}\r\n.echo-mv-candidate {\r\n  display: grid;\r\n  flex: 0 0 auto;\r\n  grid-template-columns: 56px minmax(0, 1fr);\r\n  grid-template-rows: auto auto;\r\n  grid-template-areas: \"thumb copy\" \"thumb badges\";\r\n  column-gap: 10px;\r\n  row-gap: 5px;\r\n  width: 100%;\r\n  min-height: 64px;\r\n  height: auto;\r\n  padding: 8px 9px;\r\n  text-align: left;\r\n  color: var(--echo-mv-sheet-text);\r\n  border: 1px solid var(--echo-mv-sheet-field-border);\r\n  border-radius: 10px;\r\n  background: var(--echo-mv-sheet-field-bg);\r\n  cursor: pointer;\r\n}\r\nhtml[data-theme=dark] .echo-mv-candidate {\r\n  border-color: var(--echo-mv-sheet-field-border);\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-candidate:hover {\r\n  border-color: color-mix(in srgb, var(--theme-accent, #4b55e8) 34%, var(--echo-mv-sheet-field-border));\r\n  background: color-mix(in srgb, var(--echo-mv-sheet-field-bg) 88%, var(--theme-accent, #4b55e8) 12%);\r\n}\r\n.echo-mv-candidate-thumb {\r\n  grid-area: thumb;\r\n  align-self: center;\r\n  width: 56px;\r\n  height: 40px;\r\n  overflow: hidden;\r\n  border-radius: 6px;\r\n  background: rgba(54, 73, 95, .12);\r\n}\r\n.echo-mv-candidate-thumb img,\r\n.echo-mv-candidate-thumb-fallback {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n.echo-mv-candidate-thumb-fallback {\r\n  display: grid;\r\n  place-items: center;\r\n}\r\n.echo-mv-candidate-copy {\r\n  grid-area: copy;\r\n  display: grid;\r\n  min-width: 0;\r\n  gap: 2px;\r\n}\r\n.echo-mv-candidate-copy strong,\r\n.echo-mv-candidate-copy em {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.echo-mv-candidate-copy strong {\r\n  font-size: 12px;\r\n  font-weight: 840;\r\n}\r\n.echo-mv-candidate-copy em {\r\n  color: color-mix(in srgb, var(--echo-mv-sheet-text) 62%, transparent);\r\n  font-size: 10px;\r\n  font-style: normal;\r\n}\r\n.echo-mv-candidate-badges {\r\n  grid-area: badges;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n.echo-mv-candidate-badges small {\r\n  display: inline-flex;\r\n  min-height: 18px;\r\n  align-items: center;\r\n  padding: 0 6px;\r\n  color: var(--echo-mv-sheet-chip-text);\r\n  border-radius: 999px;\r\n  background: var(--echo-mv-sheet-chip-bg);\r\n  font-size: 9px;\r\n  font-weight: 780;\r\n  line-height: 18px;\r\n}\r\nhtml[data-theme=dark] .echo-mv-candidate-badges small {\r\n  color: var(--echo-mv-sheet-chip-text);\r\n  background: var(--echo-mv-sheet-chip-bg);\r\n}\r\n.echo-mv-error {\r\n  margin: 0;\r\n  color: #8a3d38;\r\n  font-size: 12px;\r\n}\r\n.echo-mv-sheet .mv-toggle-copy em,\r\n.echo-mv-sheet .mv-threshold-copy em {\r\n  color: color-mix(in srgb, var(--echo-mv-sheet-text) 62%, transparent);\r\n}\r\n\r\n/* Sheet-scoped controls: stock MV CSS is dark-glass oriented; keep the light\r\n   floating sheet readable on playlist/library pages. */\r\n.echo-mv-sheet .mv-search-controls {\r\n  border-top-color: var(--echo-mv-sheet-border);\r\n}\r\n.echo-mv-sheet .mv-search-input,\r\n.echo-mv-sheet .mv-custom-input,\r\n.echo-mv-sheet .mv-custom-controls input,\r\n.echo-mv-sheet input[type='text'],\r\n.echo-mv-sheet input[type='search'],\r\n.echo-mv-sheet input:not([type]) {\r\n  color: var(--echo-mv-sheet-text);\r\n  border-color: var(--echo-mv-sheet-field-border);\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-sheet .mv-search-input {\r\n  color: var(--echo-mv-sheet-muted);\r\n}\r\n.echo-mv-sheet .mv-search-input:focus-within,\r\n.echo-mv-sheet .mv-custom-input:focus-within,\r\n.echo-mv-sheet input[type='text']:focus,\r\n.echo-mv-sheet input[type='search']:focus,\r\n.echo-mv-sheet input:not([type]):focus {\r\n  border-color: color-mix(in srgb, var(--theme-accent, #4b55e8) 55%, var(--echo-mv-sheet-field-border));\r\n  background: var(--echo-mv-sheet-field-bg);\r\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-accent, #4b55e8) 18%, transparent);\r\n}\r\n.echo-mv-sheet .mv-search-input input,\r\n.echo-mv-sheet .mv-custom-input input,\r\n.echo-mv-sheet input {\r\n  color: var(--echo-mv-sheet-text);\r\n  caret-color: var(--echo-mv-sheet-text);\r\n}\r\n.echo-mv-sheet .mv-search-input input::placeholder,\r\n.echo-mv-sheet .mv-custom-input input::placeholder,\r\n.echo-mv-sheet input::placeholder {\r\n  color: var(--echo-mv-sheet-muted);\r\n  opacity: .8;\r\n}\r\n.echo-mv-sheet .mv-settings-actions button,\r\n.echo-mv-sheet .mv-search-controls > button[type='submit'],\r\n.echo-mv-sheet .mv-custom-controls button,\r\n.echo-mv-sheet .mv-selected-card button,\r\n.echo-mv-sheet .mv-source-drag-handle,\r\n.echo-mv-sheet .mv-source-toggle,\r\n.echo-mv-sheet .mv-quality-trigger,\r\n.echo-mv-sheet .echo-mv-icon-btn {\r\n  color: var(--echo-mv-sheet-text);\r\n  border-color: var(--echo-mv-sheet-field-border);\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-sheet .mv-settings-actions button:hover,\r\n.echo-mv-sheet .mv-search-controls > button[type='submit']:hover,\r\n.echo-mv-sheet .mv-custom-controls button:hover,\r\n.echo-mv-sheet .mv-selected-card button:hover,\r\n.echo-mv-sheet .mv-source-drag-handle:hover,\r\n.echo-mv-sheet .mv-source-toggle:hover,\r\n.echo-mv-sheet .mv-quality-trigger:hover,\r\n.echo-mv-sheet .echo-mv-icon-btn:hover {\r\n  color: var(--echo-mv-sheet-text);\r\n  border-color: color-mix(in srgb, var(--theme-accent, #4b55e8) 30%, var(--echo-mv-sheet-field-border));\r\n  background: color-mix(in srgb, var(--echo-mv-sheet-field-bg) 82%, var(--theme-accent, #4b55e8) 18%);\r\n}\r\n.echo-mv-sheet .mv-settings-actions button:disabled,\r\n.echo-mv-sheet .mv-search-controls > button[type='submit']:disabled,\r\n.echo-mv-sheet .mv-custom-controls button:disabled {\r\n  color: var(--echo-mv-sheet-muted);\r\n  border-color: var(--echo-mv-sheet-border);\r\n  background: color-mix(in srgb, var(--echo-mv-sheet-soft-bg) 70%, transparent);\r\n  opacity: .62;\r\n}\r\n.echo-mv-sheet .mv-search-controls > button[type='submit']:disabled:hover,\r\n.echo-mv-sheet .mv-custom-controls button:disabled:hover {\r\n  background: color-mix(in srgb, var(--echo-mv-sheet-soft-bg) 70%, transparent);\r\n}\r\n.echo-mv-sheet .mv-custom-card,\r\n.echo-mv-sheet .mv-selected-card,\r\n.echo-mv-sheet .echo-mv-current {\r\n  border-color: var(--echo-mv-sheet-field-border);\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-sheet .mv-current-song-toggle,\r\n.echo-mv-sheet .mv-toggle-row,\r\n.echo-mv-sheet .settings-toggle-row {\r\n  color: var(--echo-mv-sheet-text);\r\n  border-color: var(--echo-mv-sheet-field-border);\r\n  background: var(--echo-mv-sheet-field-bg);\r\n}\r\n.echo-mv-sheet .mv-settings-search-empty,\r\n.echo-mv-sheet .mv-settings-search-error {\r\n  color: var(--echo-mv-sheet-muted);\r\n}\r\n.echo-mv-quality-item[aria-pressed=\"true\"],\r\n.echo-mv-quality-item[data-active=\"true\"],\r\nhtml[data-theme=dark] .echo-mv-quality-item[aria-pressed=\"true\"],\r\nhtml[data-theme=dark] .echo-mv-quality-item[data-active=\"true\"] {\r\n  color: #10251f;\r\n  border-color: rgba(143, 207, 189, .82);\r\n  background: #8fcfbd;\r\n  box-shadow: none;\r\n}\r\n.echo-mv-quality-item[aria-pressed=\"true\"] small,\r\n.echo-mv-quality-item[data-active=\"true\"] small,\r\nhtml[data-theme=dark] .echo-mv-quality-item[aria-pressed=\"true\"] small,\r\nhtml[data-theme=dark] .echo-mv-quality-item[data-active=\"true\"] small {\r\n  color: #1b3a32;\r\n  background: rgba(16, 37, 31, .14);\r\n}\r\n.echo-mv-sheet .mv-source-toggle .mv-switch-track,\r\n.echo-mv-sheet .mv-current-song-toggle .mv-switch-track,\r\n.echo-mv-sheet .mv-auto-apply-toggle .mv-switch-track {\r\n  background: rgba(54, 73, 95, .22);\r\n}\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-source-toggle .mv-switch-track,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-current-song-toggle .mv-switch-track,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-auto-apply-toggle .mv-switch-track {\r\n  background: rgba(255, 255, 255, .18);\r\n}\r\n.echo-mv-sheet .mv-source-toggle[aria-pressed=\"true\"] .mv-switch-track,\r\n.echo-mv-sheet .mv-current-song-toggle[aria-pressed=\"true\"] .mv-switch-track,\r\n.echo-mv-sheet .mv-auto-apply-toggle[aria-pressed=\"true\"] .mv-switch-track,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-source-toggle[aria-pressed=\"true\"] .mv-switch-track,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-current-song-toggle[aria-pressed=\"true\"] .mv-switch-track,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-auto-apply-toggle[aria-pressed=\"true\"] .mv-switch-track {\r\n  background: #8fcfbd !important;\r\n}\r\n.echo-mv-sheet .mv-source-toggle[aria-pressed=\"true\"] .mv-switch-track span,\r\n.echo-mv-sheet .mv-current-song-toggle[aria-pressed=\"true\"] .mv-switch-track span,\r\n.echo-mv-sheet .mv-auto-apply-toggle[aria-pressed=\"true\"] .mv-switch-track span,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-source-toggle[aria-pressed=\"true\"] .mv-switch-track span,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-current-song-toggle[aria-pressed=\"true\"] .mv-switch-track span,\r\nhtml[data-theme=dark] .echo-mv-sheet .mv-auto-apply-toggle[aria-pressed=\"true\"] .mv-switch-track span {\r\n  background: #10251f !important;\r\n  transform: translateX(14px) !important;\r\n}\r\n.echo-mv-sheet .mv-sync-mode-buttons button[aria-pressed=\"true\"],\r\n.echo-mv-sheet .mv-offset-step-row button[aria-pressed=\"true\"] {\r\n  color: #10251f;\r\n  border-color: rgba(143, 207, 189, .82);\r\n  background: #8fcfbd;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"] .echo-mv-sheet.audio-drawer {\r\n  left: auto;\r\n  right: 0;\r\n}\r\n\r\n/* Keep official cinema / cover stages when MV is the backdrop. */\r\n.lyrics-page[data-echo-mv-stage=\"true\"]:has(.lyrics-mv-background) .lyrics-mv-background {\r\n  z-index: 0;\r\n  background: #020407;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"cinemaStage\"]:has(.lyrics-mv-background) .lyrics-backdrop {\r\n  background: transparent !important;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"cinemaStage\"]:has(.lyrics-mv-background) .lyrics-backdrop::before {\r\n  opacity: 0.42 !important;\r\n  z-index: 2;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"cinemaStage\"]:has(.lyrics-mv-background) .lyrics-cinema-stage-chrome {\r\n  z-index: 1;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"cinemaStage\"] .lyrics-mv-settings-entry {\r\n  top: clamp(56px, 8vh, 78px);\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) {\r\n  --cover-stage-text: rgb(var(--lyrics-cover-text-rgb, 248 248 248) / 1);\r\n  --cover-stage-muted: rgb(var(--lyrics-cover-text-rgb, 248 248 248) / .78);\r\n  grid-template-columns: minmax(0, 58%) minmax(0, 42%);\r\n  grid-template-rows: minmax(0, 1fr);\r\n  gap: 0;\r\n  padding: 0;\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-mv-background {\r\n  z-index: 2;\r\n  inset: 0 auto 0 0;\r\n  width: 72%;\r\n  cursor: grab;\r\n  mask-image: linear-gradient(90deg, #000 0%, #000 42%, rgb(0 0 0 / .86) 54%, rgb(0 0 0 / .52) 68%, rgb(0 0 0 / .2) 82%, rgb(0 0 0 / .06) 92%, transparent 100%);\r\n  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 42%, rgb(0 0 0 / .86) 54%, rgb(0 0 0 / .52) 68%, rgb(0 0 0 / .2) 82%, rgb(0 0 0 / .06) 92%, transparent 100%);\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-cover-stage-artwork {\r\n  background: rgb(var(--lyrics-cover-color-deep-rgb, 22 24 30));\r\n}\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-cover-stage-image,\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-cover-stage-bridge,\r\n.lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-cover-stage-color-field {\r\n  opacity: 0;\r\n}\r\n@media (max-width: 720px) {\r\n  .lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n  .lyrics-page[data-lyrics-page-style=\"coverStage\"]:has(.lyrics-mv-background) .lyrics-mv-background {\r\n    inset: 0;\r\n    width: 100%;\r\n    mask-image: none;\r\n    -webkit-mask-image: none;\r\n  }\r\n}\r\n"
    },
    {
      "path": "README.md",
      "content": "# ECHO MV\r\n\r\n恢复官方发布版剥离的 MV（音乐视频）功能：播放条入口、原版 MV 面板与设置、在线视频源应用内播放、外部搜索（仅外部打开）。由 ShinawaseLoader 在 ECHO 主进程注入 `main.cjs`，渲染端由同包 `mod.js` 对接。\r\n\r\nRestores the music-video backend that shipping ECHO builds omit. ShinawaseLoader loads `main.cjs` inside the Electron main process; the renderer UI lives in `mod.js`.\r\n\r\n## 使用\r\n\r\n- 播放条只留 **MV 入口**：单击开关歌词页上的 Mod 自建 MV 面板（右键、`app:open-mv-settings` 打开设置）\r\n- 抽屉里的 **「启用 MV」总开关**：控制是否搜索 / 播放 MV\r\n- 官方歌词舞台布局保持不变；MV 背景和面板都由本 Mod 自己画，不依赖官方空壳导航\r\n- 抽屉内按 `Esc` 或点遮罩关闭\r\n- 注意：没有正在播放的曲目时，播放条与歌词页由应用本身隐藏，MV 按钮也会跟着不可见\r\n\r\n## 功能\r\n\r\n- 按曲目搜索 / 绑定 / 选择 MV，候选按 sourceId 去重持久化\r\n- 本地扫描：音频同目录及 `MV` / `mv` / `video` / `videos` 子目录、上级 `MV` / `video`\r\n- 在线视频源：搜索、DASH（AVC / AV1 可内嵌，无音轨；HEVC / 杜比视界除外）与 MP4 直链；流经 `echo-mv://` 代理\r\n- 外部搜索：配置 API Key 后可搜索，解析结果恒为外部打开\r\n- 自定义链接：视频页 URL 或源站视频编号\r\n- 自动匹配：阈值 0.7、领先 0.08 / 高置信 0.86，先解析可播再提交（`selectionOrigin=auto`）\r\n- 临时流：不写盘，TTL ≤ 15 分钟，`echo-mv://ephemeral/{token}`\r\n\r\n设置保存在 Steam 稳定版 `%APPDATA%\\ECHO Steam\\echo-mv-mod\\store.json`，**不会**改写 `echo-settings.json`。\r\n\r\n## 配置\r\n\r\n| 键 | 默认 | 说明 |\r\n| --- | --- | --- |\r\n| 外部搜索 API Key | `\"\"` | 空则跳过外部搜索 |\r\n| 视频源 Cookie | `\"\"` | 可选覆盖。留空则复用流媒体已登录账号，用于更高清晰度 |\r\n| `debugLog` | `false` | 冗余日志（不会打印完整 Cookie） |\r\n\r\nMV 面板里的选项（自动搜索、清晰度上限、沉浸背景等）走 `mv.getSettings` / `mv.setSettings`，与 Loader 的 `config.json` 分开。\r\n\r\n## 协议\r\n\r\n已安装的 ECHO 已把 `echo-video` / `echo-mv` 登记为特权 scheme，但没有 handler。本 Mod 在 `app.whenReady()` 后补上：\r\n\r\n- `echo-video://mv/{videoId}` — 本地文件，支持 Range / HEAD\r\n- `echo-mv://stream/{videoId}/{variantId}` — 远端流代理（Referer / UA / Cookie）\r\n- `echo-mv://ephemeral/{token}` — 临时流\r\n\r\n`TrackVideo.filePath` 对外恒为 `null`。\r\n\r\n## 开发\r\n\r\n```powershell\r\nnode --check .\\examples\\ECHO-MV\\echomod\\main.cjs\r\nnode .\\examples\\ECHO-MV\\dev\\protocol-lookup-test.mjs\r\nnode .\\examples\\ECHO-MV\\dev\\test-engine.mjs\r\n```\r\n\r\n引擎测试不启动 ECHO，只用 Node 22 全局 `fetch` 访问在线视频源。若返回 412，属风控，不是语法错误。\r\n\r\n## 限制\r\n\r\n- DASH 内嵌是「只有画面」：音轨仍走 ECHO 正在播放的音频\r\n- 无 Cookie 时 1080p+ 可能不可用，会降级\r\n- 外部搜索结果不能在应用内播\r\n- 需要 Loader native-host（`main.cjs`）。未启用时渲染端调 `main.invoke` 会失败\r\n- 在线视频源可能 412 封禁直链，约 2 分钟内改外部打开\r\n- 开发时若用 native-host `/reload` 热重载 `main.cjs`：`unhandle` → `handle` 会使已打开页面丢失 `echo-mv` / `echo-video` 的 URLLoaderFactory（渲染端合成 404，且请求不会到达 handler），需刷新页面（并重注入 `mod.js`）恢复。正常随游戏启动加载不受影响\r\n"
    }
  ]
}
