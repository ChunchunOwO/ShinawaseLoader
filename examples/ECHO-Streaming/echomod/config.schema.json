{
  "type": "object",
  "properties": {
    "locale": {
      "type": "string",
      "title": "界面语言 / UI language",
      "enum": ["zh-CN", "en-US"],
      "default": "zh-CN"
    },
    "defaultProvider": {
      "type": "string",
      "title": "Default provider",
      "enum": ["netease", "qqmusic", "soundcloud", "youtube", "spotify", "tidal", "qobuz", "bilibili"],
      "default": "netease"
    },
    "defaultQuality": {
      "type": "string",
      "title": "Default quality",
      "enum": ["lossless", "high", "standard", "hires"],
      "default": "lossless"
    },
    "defaultDownloadQuality": {
      "type": "string",
      "title": "默认下载音质 / Default download quality",
      "description": "Preselected quality in the download pickers. 'auto' follows the playback quality selector; the last quality picked in a download menu is remembered on top of this.",
      "enum": ["auto", "hires", "lossless", "high", "standard"],
      "default": "auto"
    },
    "pageSize": {
      "type": "integer",
      "title": "Search result count",
      "minimum": 10,
      "maximum": 50,
      "default": 30
    },
    "hideUnavailable": {
      "type": "boolean",
      "title": "Hide unavailable tracks",
      "default": false
    },
    "showDisabledProviders": {
      "type": "boolean",
      "title": "Show disabled providers",
      "default": true
    },
    "musicFolder": {
      "type": "string",
      "title": "音乐文件夹覆盖 / Music folder override",
      "description": "Base folder for right-click downloads. Empty = system Music folder. Tracks are saved under <folder>/Stream.",
      "default": ""
    }
  }
}
